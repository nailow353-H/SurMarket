<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment"> <!-- ESTO HACE QUE LOGIN SEA LA PRIMERA PANTALLA -->

    <!-- Fragmento 1: Login -->
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.surmarket.FragmentLogin"
        android:label="Login"
        tools:layout="@layout/fragment_login">

        <!-- Acción para ir a la lista de productos al iniciar sesión con éxito-->
        <action
            android:id="@+id/action_login_to_product_list"
            app:destination="@id/products_list_fragment" />

        <!-- Acción para ir al fragmento de registro si el usuario da clic en "Regístrate aquí" -->
        <action
            android:id="@+id/action_login_to_register"
            app:destination="@id/registerFragment" />
    </fragment>

    <!-- Fragmento 2: Lista de Productos -->
    <fragment
        android:id="@+id/products_list_fragment"
        android:name="com.example.surmarket.FragmentProductList"
        android:label="Lista de productos"
        tools:layout="@layout/fragment_products_list">

        <action
            android:id="@+id/action_products_list_to_add_product"
            app:destination="@id/add_product_fragment" />
    </fragment>

    <!-- Fragmento 3: Registro -->
    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.surmarket.FragmentRegistro"
        android:label="Registro"
        tools:layout="@layout/fragment_registro" />

    <fragment
        android:id="@+id/add_product_fragment"
        android:name="com.example.surmarket.FragmentAddProduct"
        android:label="Añadir producto"
        tools:layout="@layout/fragment_add_product" />

</navigation>