<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".FragmentProductList">

    <!-- 1. Encabezado: Título y Carrito (Horizontal) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/title_height"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/txb_frg_products_list_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/frg_products_list_title"
            android:textSize="@dimen/frg_title_text_size"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/imb_frg_products_list_shopping_cart"
            android:layout_width="@dimen/image_view_icon_size"
            android:layout_height="@dimen/image_view_icon_size"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="@string/shopping_cart"
            android:clickable="true"
            android:focusable="true"
            android:padding="@dimen/image_view_icon_padding" />
    </LinearLayout>

    <!-- 2. Barra de Búsqueda (CardView con LinearLayout Horizontal) -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="#E8EDF2"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">

            <ImageView
                android:id="@+id/imb_frg_products_list_search"
                android:layout_width="@dimen/image_view_icon_size"
                android:layout_height="@dimen/image_view_icon_size"
                android:src="@android:drawable/ic_menu_search"
                android:contentDescription="@string/search" />

            <EditText
                android:id="@+id/etx_frg_products_list_search"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/search"
                android:inputType="text"
                android:maxLines="1"
                android:background="@android:color/transparent"
                android:padding="12dp"
                android:textSize="@dimen/frg_label_text_size" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 3. Botón Añadir Producto -->
    <Button
        android:id="@+id/btn_frg_products_list_add_product"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:text="@string/btn_product_list_add"
        android:textSize="@dimen/frg_label_text_size" />

    <!-- Nota: En el próximo video el ingeniero añadirá el RecyclerView aquí abajo para la lista -->

</LinearLayout>