<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".FragmentLogin">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/frg_container_padding">

        <!-- Espacio superior dinámico -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Título -->
        <TextView
            android:id="@+id/txb_frg_login_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/frg_login_title"
            android:textSize="@dimen/frg_title_text_size"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="@dimen/margin_bottom_large" />

        <!-- Etiqueta Nombre de usuario -->
        <TextView
            android:id="@+id/txb_frg_login_username"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/frg_login_username"
            android:textSize="@dimen/label_text_size" />

        <!-- Caja Nombre de usuario -->
        <EditText
            android:id="@+id/etx_frg_login_username"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/frg_login_username_hint"
            android:inputType="text"
            android:textSize="@dimen/label_text_size"
            android:layout_marginBottom="@dimen/margin_bottom_small" />

        <!-- Etiqueta Contraseña -->
        <TextView
            android:id="@+id/txb_frg_login_password"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/frg_login_password"
            android:textSize="@dimen/label_text_size" />

        <!-- Caja Contraseña (inputType="textPassword" oculta los caracteres) -->
        <EditText
            android:id="@+id/etx_frg_login_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/frg_login_password_hint"
            android:inputType="textPassword"
            android:textSize="@dimen/label_text_size"
            android:layout_marginBottom="@dimen/margin_bottom_small" />

        <!-- Recuperar Contraseña -->
        <TextView
            android:id="@+id/txb_frg_login_recover_password"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/frg_login_recover_password"
            android:textSize="14sp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="@dimen/margin_bottom_large" />

        <!-- Espacio inferior dinámico antes de los botones -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2" />

        <!-- Botón Iniciar Sesión -->
        <Button
            android:id="@+id/btn_frg_login_login"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/frg_login_login"
            android:textSize="@dimen/label_text_size" />

        <!-- Botón Registrarse -->
        <Button
            android:id="@+id/btn_frg_login_register"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/frg_login_register"
            android:textSize="@dimen/label_text_size" />

    </LinearLayout>
</ScrollView>