<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- Imagen del producto[cite: 6] -->

        <!-- Contenedor vertical para Categoría, Nombre, Precio y Botón[cite: 6] -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txb_it_product_list_category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="Categoría: Alimentos"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/txb_it_product_list_product_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="Arroz"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txb_it_product_list_product_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="Bs. 10.00"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btn_it_product_list_buy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Comprar"
                android:textSize="12sp" />

        </LinearLayout>

        <ImageView
            android:id="@+id/imb_it_product_list_product_imagen"
            android:layout_width="110dp"
            android:layout_height="116dp"
            android:contentDescription="Producto"
            android:scaleType="centerCrop"
            android:src="@mipmap/ic_launcher" />

    </LinearLayout>
</androidx.cardview.widget.CardView>