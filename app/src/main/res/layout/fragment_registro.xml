<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".FragmentRegistro">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/frg_container_padding">

        <!-- Espacio superior dinámico -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Título -->
        <TextView
            android:id="@+id/txb_frg_register_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/frg_register_title"
            android:textSize="@dimen/frg_title_text_size"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="30dp" />

        <!-- Nombre completo -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/frg_register_fullname"
            android:textSize="@dimen/frg_label_text_size" />
        <EditText
            android:id="@+id/etx_frg_register_fullname"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/frg_register_fullname_hint"
            android:inputType="textPersonName"
            android:textSize="@dimen/frg_label_text_size"
            android:layout_marginBottom="16dp" />

        <!-- Correo electrónico -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/frg_register_email"
            android:textSize="@dimen/frg_label_text_size" />
        <EditText
            android:id="@+id/etx_frg_register_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/frg_register_email_hint"
            android:inputType="textEmailAddress"
            android:textSize="@dimen/frg_label_text_size"
            android:layout_marginBottom="16dp" />

        <!-- Número de celular -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/frg_register_phone"
            android:textSize="@dimen/frg_label_text_size" />
        <EditText
            android:id="@+id/etx_frg_register_phone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/frg_register_phone_hint"
            android:inputType="phone"
            android:textSize="@dimen/frg_label_text_size"
            android:layout_marginBottom="16dp" />

        <!-- Contraseña -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/frg_login_password"
            android:textSize="@dimen/frg_label_text_size" />
        <EditText
            android:id="@+id/etx_frg_register_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/frg_login_password_hint"
            android:inputType="textPassword"
            android:textSize="@dimen/frg_label_text_size"
            android:layout_marginBottom="30dp" />

        <!-- Botón Crear Cuenta -->
        <Button
            android:id="@+id/btn_frg_register_submit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_frg_register_submit"
            android:textSize="@dimen/frg_label_text_size" />

        <!-- Espacio inferior dinámico -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2" />

    </LinearLayout>
</ScrollView>